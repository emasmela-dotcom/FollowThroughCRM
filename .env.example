# Required: Neon (free tier) – https://neon.tech – no credit card
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Required: any random string for session encryption
NEXTAUTH_SECRET=your-secret-at-least-32-chars

# App URL — include scheme (https://...). Host-only URLs break builds (metadataBase).
# Vercel: use https://your-domain.com or your .vercel.app URL
NEXTAUTH_URL=http://localhost:3000

# Optional: Reminder emails + forgot-password emails. If unset, reminders and reset emails are not sent (no cost).
# Resend free tier: 100 emails/day – https://resend.com
# RESEND_API_KEY=re_xxxx
# Optional: verified sender in Resend (default: onboarding@resend.dev)
# AUTH_EMAIL_FROM="Follow Thru CRM <onboarding@resend.dev>"

# Optional: Google Analytics 4 — GA Admin → Data streams → Web → Measurement ID
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-xxxxxxxxxx

# Optional: Marketing — Stripe Payment Link (or any URL) shown on the public home page as “Support Follow Thru”
# NEXT_PUBLIC_MARKETING_CHECKOUT_URL=https://buy.stripe.com/...
